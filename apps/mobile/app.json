{
  "expo": {
    "name": "تراحيب",
    "slug": "traheeb",
    "owner": "fatrammah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-1.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "traheeb",
    "ios": {
      "supportsTablet": false,
      "requiresFullScreen": true,
      "bundleIdentifier": "com.traheeb.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "يستخدم التطبيق الكاميرا لمسح رموز QR عند دخول الضيوف إلى الفعالية.",
        "NSMicrophoneUsageDescription": "يستخدم التطبيق الميكروفون لتشغيل الصوت داخل الفعالية.",
        "NSSpeechRecognitionUsageDescription": "يستخدم التطبيق التعرف على الكلام لتحسين تجربة المستخدم."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-1.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ],
      "package": "com.traheeb.app"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "يستخدم التطبيق الكاميرا لمسح رموز QR عند دخول الضيوف إلى الفعالية."
        }
      ],
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-1.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "يستخدم التطبيق الميكروفون لتشغيل الصوت داخل الفعالية.",
          "speechRecognitionPermission": "يستخدم التطبيق التعرف على الكلام لتحسين تجربة المستخدم."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false,
        "sitemap": false
      },
      "eas": {
        "projectId": "aaff4c2b-073e-4d92-8bfe-162092ac62e6"
      }
    }
  }
}
